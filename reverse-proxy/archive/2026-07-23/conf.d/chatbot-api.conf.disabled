# ============================================
# Chatbot API Routes
# ============================================
upstream chatbot_api {
    server chatbot-api-dev-backend-chatbot-1:8183 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP → HTTPS redirect
server {
    listen 80;
    server_name dev.245bates.sourri.com;
    return 301 https://$server_name$request_uri;
}

# HTTPS
server {
    listen 443 ssl http2;
    server_name dev.245bates.sourri.com;
    
    ssl_certificate /etc/nginx/ssl/dev.245bates.sourri.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dev.245bates.sourri.com/privkey.pem;
    include /etc/nginx/ssl-params.conf;
    
    # API routes
    location /api/ {
        proxy_pass http://chatbot_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS if needed
        add_header Access-Control-Allow-Origin * always;
    }
    
    # Health check
    location /health {
        proxy_pass http://chatbot_api;
        access_log off;
    }
}
