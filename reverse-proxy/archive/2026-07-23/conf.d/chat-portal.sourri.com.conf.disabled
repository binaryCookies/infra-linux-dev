# ============================================
# Sourri AI SuperAdmin Panel
# chat-portal.sourri.com
# ============================================

# HTTP → HTTPS redirect
server {
    listen 80;
    server_name chat-portal.sourri.com;
    return 301 https://$host$request_uri;
}

# HTTPS
server {
    listen 443 ssl;
    server_name chat-portal.sourri.com;

    ssl_certificate     /etc/nginx/ssl/chat-portal.sourri.com.crt;
    ssl_certificate_key /etc/nginx/ssl/chat-portal.sourri.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_prefer_server_ciphers on;

    location / {
        proxy_pass         http://admin-panel:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    access_log  /var/log/nginx/chat-portal.sourri.com-access.log;
    error_log   /var/log/nginx/chat-portal.sourri.com-error.log;
}
