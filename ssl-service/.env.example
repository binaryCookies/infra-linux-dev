# =============================================================================
# SSL SERVICE — Environment Template
# Copy to .env and fill in actual values.  NEVER commit .env to Git.
#
# cp .env.example .env && nano .env
# =============================================================================

# Image tag to deploy (set by CI or manually)
# Use a specific build tag in production (e.g. 1.0.0-abc1234-20260512-120000)
IMAGE_TAG=latest

# Environment
NODE_ENV=production
APP_PORT=8888

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ssl_service
DB_USER=ssl_admin
DB_PASSWORD=CHANGEME_STRONG_PASSWORD

# GoDaddy DNS Provider
GD_KEY=YOUR_GODADDY_API_KEY
GD_SECRET=YOUR_GODADDY_API_SECRET
GD_BASE_URL=https://api.godaddy.com

# ACME / Let's Encrypt
# Staging (safe for testing): https://acme-staging-v02.api.letsencrypt.org/directory
# Production:                 https://acme-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_EMAIL=admin@example.com

# Encryption key (CRITICAL — generate with: openssl rand -base64 32)
ENCRYPTION_KEY=CHANGEME_GENERATE_WITH_OPENSSL

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
